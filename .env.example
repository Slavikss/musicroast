# Обязательные
GOOGLE_API_KEY=
TELEGRAM_BOT_TOKEN=

# Режим процесса: both (API + бот в одном процессе, дефолт) | api | bot
APP_MODE=both

# Gemini-модели (дефолты обычно менять не нужно)
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# OAuth client_id официального приложения Яндекс Музыки (менять не нужно)
YANDEX_OAUTH_CLIENT_ID=23cabbbdc6cd418abb4b39c32c41195d

# TTL хранилищ, сек
TOKEN_STORAGE_DEFAULT_TTL=86400
BATTLE_TTL=3600
ROAST_TTL=604800
DEVICE_AUTH_TTL=600

# MOCK_STREAMING=1 — вместо Яндекса отдаётся тестовая библиотека (e2e без токена)
MOCK_STREAMING=

# Оверрайд юзернейма бота для deep-link'ов (обычно берётся из get_me)
TELEGRAM_BOT_USERNAME=
