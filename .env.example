# Обязательные
# Ключ LLM-провайдера (по умолчанию OpenRouter). Можно и LLM_API_KEY.
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=

# Режим процесса: both (API + бот в одном процессе, дефолт) | api | bot
APP_MODE=both

# LLM: провайдер и модели задаются через env — сменить модель = сменить строку
LLM_BASE_URL=https://openrouter.ai/api/v1
# Модель OpenRouter. openrouter/free = любая доступная бесплатная (авто-роутинг, обходит лимит)
LLM_TEXT_MODEL=google/gemma-4-31b-it:free
LLM_IMAGE_MODEL=google/gemini-2.5-flash-image-preview
LLM_TEMPERATURE=1.0

# OAuth client_id официального приложения Яндекс Музыки (менять не нужно)
YANDEX_OAUTH_CLIENT_ID=23cabbbdc6cd418abb4b39c32c41195d

# TTL хранилищ, сек
TOKEN_STORAGE_DEFAULT_TTL=86400
BATTLE_TTL=3600
ROAST_TTL=604800
DEVICE_AUTH_TTL=600

# MOCK_STREAMING=1 — вместо Яндекса отдаётся тестовая библиотека (e2e без токена)
MOCK_STREAMING=

# Оверрайд юзернейма бота для deep-link'ов (обычно берётся из get_me)
TELEGRAM_BOT_USERNAME=
